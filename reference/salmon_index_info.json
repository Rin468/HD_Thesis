out_dir    <- paste0("~/arcticles/", dataset_name, "/Analysis/Outputs")
tx2gene_f  <- "~/arcticles/Reference/tx2gene_v44.csv"
gtf_f      <- "~/arcticles/Reference/gencode.v44.annotation.gtf"

dir.create(path.expand(meta_dir), recursive = TRUE, showWarnings = FALSE)
dir.create(path.expand(out_dir), recursive = TRUE, showWarnings = FALSE)

## ---- 1. tx2gene (build once, shared across all datasets) ----
tx2gene_path <- path.expand(tx2gene_f)
if (!file.exists(tx2gene_path)) {
  library(GenomicFeatures)
  library(rtracklayer)
  gtf <- import(path.expand(gtf_f))
  tx2gene <- as.data.frame(mcols(gtf)[gtf$type == "transcript", c("transcript_id", "gene_id")])
  write.csv(tx2gene, tx2gene_path, row.names = FALSE)
} else {
  tx2gene <- read.csv(tx2gene_path)
}
## strip version suffix so IDs match salmon's unversioned quant.sf output
tx2gene$transcript_id <- sub("\\..*$", "", tx2gene$transcript_id)
